-- ===== MATH QUESTION GENERATOR =====
local function GenerateMathQuestion()
    local ops = {
        {sym = "+", calc = function(a,b) return a+b end},
        {sym = "−", calc = function(a,b) return a-b end},
        {sym = "×", calc = function(a,b) return a*b end},
        {sym = "÷", calc = function(a,b) return a/b end}
    }

    local op = ops[math.random(#ops)]
    local a, b, ans

    if op.sym == "+" or op.sym == "−" then
        a = math.random(-10, 10)
        b = math.random(-10, 10)
        ans = op.calc(a, b)

    elseif op.sym == "×" then
        a = math.random(-5, 5)
        b = math.random(-5, 5)
        ans = op.calc(a, b)

    else
        b = math.random(-5, 5)
        if b == 0 then b = 2 end
        ans = math.random(-5, 5)
        a = ans * b
    end

    ans = tonumber(string.format("%.0f", ans))

    return a .. " " .. op.sym .. " " .. b .. " = ?", tostring(ans)
end

