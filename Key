-- ===== SUPABASE REQUEST =====
local function LoadBlueMode()
    Question.Text = "⏳ CONNECTING TO SERVER..."
    Question.TextColor3 = Color3.fromRGB(0, 200, 255)
    ConfirmBtn.Text = "PLEASE WAIT..."
    ConfirmBtn.Active = false

    task.spawn(function()
        local success, result = pcall(function()

            local requestFunction =
                request or http_request or
                (syn and syn.request)

            if not requestFunction then
                error("HTTP request function unavailable.")
            end

            local response = requestFunction({
                Url = LOADER_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["apikey"] = SUPABASE_ANON_KEY,
                    ["Authorization"] = "Bearer " .. SUPABASE_ANON_KEY
                },
                Body = "{}"
            })

            if not response then
                error("No server response.")
            end

            local status = response.StatusCode or response.Status

            if status ~= 200 then
                error("Server returned HTTP " .. tostring(status))
            end

            local data = HttpService:JSONDecode(response.Body)

            if data.success ~= true then
                error(data.error or "Server authorization failed.")
            end

            if type(data.script) ~= "string" or data.script == "" then
                error("Main script is missing.")
            end

            return data.script
        end)

        if not success then
            if KeyUI.Parent then
                Question.Text = "❌ CONNECTION FAILED"
                Question.TextColor3 = Color3.fromRGB(255, 80, 80)
                ConfirmBtn.Text = "✓ RETRY"
                ConfirmBtn.Active = true
            end

            warn("[BLUE MODE LOADER] " .. tostring(result))
            return
        end

        if not KeyUI.Parent then return end

        CloseAndDeleteEverything()

        task.wait(0.1)

        local compiled, loadError = loadstring(result)

        if not compiled then
            warn("[BLUE MODE HUB] Compilation failed: " .. tostring(loadError))
            return
        end

        local executed, executionError = pcall(compiled)

        if not executed then
            warn("[BLUE MODE HUB] Execution failed: " .. tostring(executionError))
        end
    end)
end

