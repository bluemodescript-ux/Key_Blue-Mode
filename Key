    local function GetPlayerActivity(Player)
        if not Player or not Player.Character then
            return "Player not loaded"
        end

        local Char = Player.Character
        local Humanoid = Char:FindFirstChildOfClass("Humanoid")
        if not Humanoid then return "No humanoid" end

        local RootPart = Char:FindFirstChild("HumanoidRootPart")
        if not RootPart then return "No root part" end

        local velocity = RootPart.AssemblyLinearVelocity.Magnitude
        local isInAir = Humanoid:GetState() == Enum.HumanoidStateType.Freefall or Humanoid:GetState() == Enum.HumanoidStateType.Flying or Humanoid:GetState() == Enum.HumanoidStateType.Jumping

        local activity = ""
        
        if Humanoid.Health <= 0 then
            activity = "💀 DEAD"
        elseif isInAir then
            activity = "🛫 JUMPING/FLYING"
        elseif velocity > 2 then
            activity = "🏃 RUNNING (Speed: " .. math.floor(velocity) .. ")"
        else
            activity = "🚶 IDLE/WALKING"
        end

        return activity
    end

